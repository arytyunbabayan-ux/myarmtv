# ============================================
# MyTVS - Configuration File
# ============================================

# Server Configuration
PORT=3000

# ============================================
# Telegram Bot Configuration
# ============================================

# Шаг 1: Получите токен у @BotFather в Telegram
# - Найдите @BotFather
# - Отправьте /newbot
# - Следуйте инструкциям
# - Скопируйте токен сюда (без пробелов!)
TELEGRAM_BOT_TOKEN=

# Шаг 2: Получите ваш chat_id у @userinfobot
# - Найдите @userinfobot
# - Нажмите Start
# - Скопируйте ваш ID сюда
TELEGRAM_CHAT_ID=

# ============================================
# Admin Credentials
# ============================================

# ВАЖНО: Измените пароль на надежный!
ADMIN_USERNAME=admin1973
ADMIN_PASSWORD=

# ============================================
# Database
# ============================================

# SQLite создается автоматически
# Файл: database.sqlite
# Настройка не требуется

# ============================================
# ИНСТРУКЦИЯ ПО ЗАПОЛНЕНИЮ:
# ============================================

# 1. Удалите эти комментарии после настройки
# 2. Убедитесь что нет пробелов после значений
# 3. Не используйте кавычки
# 4. Сохраните файл как .env (без расширения)

# Пример правильного заполнения:
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=123456789
# ADMIN_PASSWORD=MySecurePassword123!